@import url('https://imbypass.github.io/base16-discord/omarchy-discord.theme.css');

:root {
  --color00: {{ background }};
  --color01: {{ dark_background }};
  --color02: {{ lighter_background }};
  --color03: {{ selection }};
  --color04: {{ muted }};
  --color05: {{ foreground }};
  --color06: {{ light_foreground }};
  --color07: {{ bright_foreground }};
  --color08: {{ red }};
  --color09: {{ orange }};
  --color10: {{ yellow }};
  --color11: {{ green }};
  --color12: {{ cyan }};
  --color13: {{ blue }};
  --color14: {{ magenta }};
  --color15: {{ accent }};
}
